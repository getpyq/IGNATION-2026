# Google Sheets + Google Apps Script Integration (Required for all operations)
# 1. Open your Google Sheet -> Extensions -> Apps Script
# 2. Paste the contents of google-apps-script/Code.gs
# 3. Click Deploy -> New deployment -> Web app ("Execute as: Me", "Who has access: Anyone")
# 4. Copy the resulting /exec Web App URL below:
APPS_SCRIPT_URL=""

# Optional shared secret matching Script Property APPS_SCRIPT_SECRET in Apps Script
APPS_SCRIPT_SECRET=""
